# Server
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=.data/averis.sqlite
SESSION_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:4173

# First-run organization
BOOTSTRAP_ORG_NAME=ACME Indonesia
BOOTSTRAP_ORG_SLUG=acme-indonesia

# Set strong, unique passwords before the first run. If omitted, the server
# generates one-time random passwords and prints them only on first boot.
BOOTSTRAP_SUPER_ADMIN_EMAIL=owner@acme.co.id
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@acme.co.id
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MANAGER_EMAIL=manager@acme.co.id
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_EMPLOYEE_EMAIL=andini@acme.co.id
BOOTSTRAP_EMPLOYEE_PASSWORD=
# URL publik untuk tautan email dan simulasi
PUBLIC_APP_URL=http://localhost:4173

# Opsional. Tanpa SMTP, email tetap Pending. Lindungi database karena payload
# undangan/reset dapat mengandung tautan token sampai pengiriman berhasil.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AVERIS <no-reply@example.com>

# Optional OIDC SSO: all values required, HTTPS only, single configured tenant.
# Register PUBLIC_APP_URL/api/auth/sso/callback as the exact redirect URI.
# The issuer must provide signed ID tokens with email and email_verified=true.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ORG_SLUG=

# Enable only for controlled review of old prototype APIs; default false.
LEGACY_API_ENABLED=false
# Set true only behind exactly one trusted reverse proxy.
TRUST_PROXY=false
